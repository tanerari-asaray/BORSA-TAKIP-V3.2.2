<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_screen_gradient">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView style="@style/Title" android:text="Sinyal Geçmişi"/><TextView android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/bg_card_purple" android:text="GEÇMİŞ" android:textColor="@color/white" android:textSize="9sp" android:textStyle="bold"/></LinearLayout>
        <TextView android:id="@+id/historyStatus" style="@style/Sub" android:layout_width="match_parent" android:layout_marginTop="4dp" android:text="Geçmiş kayıtları yükleniyor..."/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><TextView android:id="@+id/historyTotal" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:gravity="center" android:background="@drawable/bg_card" android:text="Toplam\n0" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/historySuccess" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:gravity="center" android:background="@drawable/bg_card_green" android:text="Başarılı\n—" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/historyRate" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:gravity="center" android:background="@drawable/bg_card_blue" android:text="Oran\n—" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/historyAvgReturn" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1" android:layout_marginStart="3dp" android:gravity="center" android:background="@drawable/bg_card_purple" android:text="Ort. Getiri\n—" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/historyAll" style="@style/FilterButton" android:layout_width="74dp" android:layout_weight="0" android:text="TÜMÜ" android:textColor="@color/blue"/><Button android:id="@+id/historyLong" style="@style/FilterButton" android:layout_width="74dp" android:layout_weight="0" android:text="LONG" android:textColor="@color/green" android:layout_marginStart="5dp"/><Button android:id="@+id/historyShort" style="@style/FilterButton" android:layout_width="74dp" android:layout_weight="0" android:text="SHORT" android:textColor="@color/red" android:layout_marginStart="5dp"/><Button android:id="@+id/history85" style="@style/FilterButton" android:layout_width="74dp" android:layout_weight="0" android:text="85+" android:textColor="@color/yellow" android:layout_marginStart="5dp"/><Button android:id="@+id/history75" style="@style/FilterButton" android:layout_width="74dp" android:layout_weight="0" android:text="75+" android:layout_marginStart="5dp"/></LinearLayout></HorizontalScrollView>
        <EditText android:id="@+id/historySymbol" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="9dp" android:background="@drawable/bg_input" android:paddingHorizontal="12dp" android:hint="⌕  Sembol ara..." android:inputType="textCapCharacters" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:singleLine="true"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp"><EditText android:id="@+id/historyFrom" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:background="@drawable/bg_input" android:paddingHorizontal="10dp" android:hint="Başlangıç" android:inputType="date" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"/><EditText android:id="@+id/historyTo" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="7dp" android:background="@drawable/bg_input" android:paddingHorizontal="10dp" android:hint="Bitiş" android:inputType="date" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"/></LinearLayout>
        <Button android:id="@+id/historyApply" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card_blue" android:text="FİLTREYİ UYGULA" android:textColor="@color/white" android:textStyle="bold"/><Button android:id="@+id/historyForward" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="7dp" android:background="@drawable/bg_card_purple" android:text="FORWARD TEST / PERFORMANS  ›" android:textColor="@color/white" android:textStyle="bold" android:textSize="11sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="SİNYAL KAYITLARI" android:textColor="@color/blue" android:textStyle="bold" android:textSize="12sp"/><TextView android:id="@+id/historyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_card" android:padding="13dp" android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="5dp"/>
    </LinearLayout></ScrollView><include layout="@layout/include_bottom_nav"/>
</LinearLayout>