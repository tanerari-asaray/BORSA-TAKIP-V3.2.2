<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_screen_gradient">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
<TextView style="@style/Title" android:text="Teknik Analiz"/><TextView android:id="@+id/technicalHeader" style="@style/Sub" android:layout_width="match_parent" android:layout_marginTop="3dp"/><TextView android:id="@+id/technicalScoreCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="@drawable/bg_card_blue" android:padding="12dp" android:textColor="@color/white" android:textStyle="bold" android:textSize="12sp"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/tabIndicators" style="@style/FilterButton" android:layout_width="104dp" android:layout_weight="0" android:text="GÖSTERGELER" android:textColor="@color/blue"/><Button android:id="@+id/tabPatterns" style="@style/FilterButton" android:layout_width="100dp" android:layout_weight="0" android:layout_marginStart="5dp" android:text="FORMASYON"/><Button android:id="@+id/tabLevels" style="@style/FilterButton" android:layout_width="128dp" android:layout_weight="0" android:layout_marginStart="5dp" android:text="DESTEK / DİRENÇ"/></LinearLayout></HorizontalScrollView>
<LinearLayout android:id="@+id/panelIndicators" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="9dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GÖSTERGELER" android:textColor="@color/blue" android:textStyle="bold" android:textSize="12sp"/><TextView android:id="@+id/technicalIndicators" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_card" android:padding="13dp" android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="5dp"/></LinearLayout>
<LinearLayout android:id="@+id/panelPatterns" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="9dp" android:visibility="gone"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FORMASYON" android:textColor="@color/blue" android:textStyle="bold" android:textSize="12sp"/><TextView android:id="@+id/technicalPatterns" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_card" android:padding="13dp" android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="5dp"/></LinearLayout>
<LinearLayout android:id="@+id/panelLevels" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="9dp" android:visibility="gone"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DESTEK / DİRENÇ" android:textColor="@color/blue" android:textStyle="bold" android:textSize="12sp"/><TextView android:id="@+id/technicalLevels" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_card" android:padding="13dp" android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="5dp"/></LinearLayout>
<TextView android:id="@+id/technicalNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card_yellow" android:padding="11dp" android:textColor="@color/text_primary" android:textSize="10sp" android:lineSpacingExtra="3dp"/>
</LinearLayout></ScrollView><include layout="@layout/include_bottom_nav"/></LinearLayout>