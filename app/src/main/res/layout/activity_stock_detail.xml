<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_screen_gradient">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="‹" android:textColor="@color/text_secondary" android:textSize="30sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                    <TextView android:id="@+id/title" style="@style/Title" android:textSize="20sp"/>
                    <TextView android:id="@+id/subtitle" style="@style/Sub" android:layout_marginTop="1dp"/>
                </LinearLayout>
                <TextView android:id="@+id/stockViopBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_card_purple" android:paddingHorizontal="7dp" android:paddingVertical="5dp" android:text="VİOP UYGUN" android:textColor="@color/white" android:textSize="9sp" android:textStyle="bold" android:visibility="gone"/>
                <TextView android:id="@+id/stockFavorite" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="☆" android:textColor="@color/yellow" android:textSize="27sp"/>
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnOverviewScreen" style="@style/FilterButton" android:layout_width="72dp" android:layout_weight="0" android:text="GENEL" android:textColor="@color/blue"/>
                <Button android:id="@+id/btnTechnicalScreen" style="@style/FilterButton" android:layout_width="72dp" android:layout_weight="0" android:layout_marginStart="5dp" android:text="TEKNİK"/>
                <Button android:id="@+id/btnNewsScreen" style="@style/FilterButton" android:layout_width="72dp" android:layout_weight="0" android:layout_marginStart="5dp" android:text="HABER"/>
                <Button android:id="@+id/btnSignalScreen" style="@style/FilterButton" android:layout_width="72dp" android:layout_weight="0" android:layout_marginStart="5dp" android:text="SİNYAL"/>
                <Button android:id="@+id/btnViopScreen" style="@style/FilterButton" android:layout_width="72dp" android:layout_weight="0" android:layout_marginStart="5dp" android:text="VİOP" android:textColor="@color/purple"/>
            </LinearLayout></HorizontalScrollView>
            <TextView android:id="@+id/scoreSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card_blue" android:padding="13dp" android:textColor="@color/white" android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="FİYAT / GRAFİK" android:textColor="@color/blue" android:textStyle="bold" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                <Button android:id="@+id/btnRange1D" style="@style/FilterButton" android:text="1G"/><Button android:id="@+id/btnRange1W" style="@style/FilterButton" android:text="1H" android:layout_marginStart="3dp"/><Button android:id="@+id/btnRange1M" style="@style/FilterButton" android:text="1A" android:layout_marginStart="3dp"/><Button android:id="@+id/btnRange3M" style="@style/FilterButton" android:text="3A" android:layout_marginStart="3dp"/><Button android:id="@+id/btnRange6M" style="@style/FilterButton" android:text="6A" android:layout_marginStart="3dp"/><Button android:id="@+id/btnRange1Y" style="@style/FilterButton" android:text="1Y" android:layout_marginStart="3dp"/>
            </LinearLayout>
            <tr.borsatakip.v5.ui.PriceChartView android:id="@+id/chart" android:layout_width="match_parent" android:layout_height="245dp" android:layout_marginTop="7dp" android:background="@drawable/bg_card" android:padding="7dp"/>
            <TextView android:id="@+id/chartStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_muted" android:textSize="10sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp"><Button android:id="@+id/btnTradingView" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/bg_card_blue" android:text="TRADINGVIEW'DA AÇ" android:textColor="@color/white" android:textSize="10sp"/><Button android:id="@+id/btnDepth" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="3dp" android:background="@drawable/bg_card" android:text="DERİNLİK" android:textColor="@color/text_primary" android:textSize="10sp"/></LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="SİNYAL ÖZETİ" android:textColor="@color/blue" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:id="@+id/overview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/bg_card" android:padding="12dp" android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="4dp"/>
            <TextView android:id="@+id/trendCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_card" android:padding="11dp" android:textColor="@color/text_primary" android:textSize="11sp"/>
            <TextView android:id="@+id/momentumCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_card" android:padding="11dp" android:textColor="@color/text_primary" android:textSize="11sp"/>
            <TextView android:id="@+id/macdCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_card" android:padding="11dp" android:textColor="@color/text_primary" android:textSize="11sp"/>
            <TextView android:id="@+id/volumeCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_card" android:padding="11dp" android:textColor="@color/text_primary" android:textSize="11sp"/>
            <TextView android:id="@+id/extraCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_card" android:padding="11dp" android:textColor="@color/text_primary" android:textSize="11sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="TEKNİK / TEMEL BİLGİ" android:textColor="@color/blue" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:id="@+id/technicalDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/bg_card" android:padding="12dp" android:textColor="@color/text_primary" android:textSize="11sp" android:lineSpacingExtra="4dp"/>
            <TextView android:id="@+id/validity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_card_yellow" android:padding="10dp" android:textColor="@color/text_primary" android:textSize="10sp"/>
            <TextView android:id="@+id/dataQuality" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_card" android:padding="11dp" android:textColor="@color/text_primary" android:textSize="11sp"/>
            <TextView android:id="@+id/dataStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_card" android:padding="11dp" android:textColor="@color/text_secondary" android:textSize="11sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><Button android:id="@+id/btnTradeAnalysis" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_card_blue" android:text="AL/SAT ANALİZİ" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold"/><Button android:id="@+id/btnFollowStock" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/bg_card_green" android:text="TAKİP ET" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold"/></LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/include_bottom_nav"/>
</LinearLayout>