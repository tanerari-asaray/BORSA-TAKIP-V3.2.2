<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="13dp" android:layout_marginBottom="9dp" android:background="@drawable/bg_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/favoriteToggle" android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:text="☆" android:textColor="@color/yellow" android:textSize="24sp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/company" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/symbol" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="@color/text_secondary" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/viopEligibleBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_card_purple" android:paddingHorizontal="7dp" android:paddingVertical="4dp" android:text="VİOP UYGUN" android:textColor="@color/white" android:textSize="9sp" android:textStyle="bold" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/score" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:padding="9dp" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text_primary" android:maxLines="2" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/strengthLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nihai Sinyal" android:textStyle="bold" android:textColor="@color/text_secondary" android:textSize="11sp"/>
        <ProgressBar android:id="@+id/strengthBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="7dp" android:layout_weight="1" android:layout_marginStart="10dp" android:layout_marginEnd="8dp" android:max="100" android:progress="0"/>
        <TextView android:id="@+id/strengthValue" android:layout_width="55dp" android:layout_height="wrap_content" android:gravity="end" android:textStyle="bold" android:textColor="@color/green" android:textSize="14sp"/>
    </LinearLayout>
    <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_secondary" android:textSize="11sp" android:lineSpacingExtra="2dp"/>
    <TextView android:id="@+id/risk" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/yellow" android:textSize="11sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="9dp">
        <Button android:id="@+id/actionGraph" style="@style/FilterButton" android:text="GRAFİK" android:textColor="@color/blue" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/actionDetail" style="@style/FilterButton" android:text="DETAY" android:textColor="@color/text_primary" android:layout_marginHorizontal="3dp"/>
        <Button android:id="@+id/actionNews" style="@style/FilterButton" android:text="HABER" android:textColor="@color/purple" android:layout_marginStart="3dp"/>
    </LinearLayout>
</LinearLayout>